{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "date",
          "topic",
          "minutes"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "schedule",
    "summary"
  ],
  "additionalProperties": false
}
