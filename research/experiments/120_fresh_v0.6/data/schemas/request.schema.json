{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^N(?:D(?:CW|SP)(?:0[1-9]|1[0-9]|20)|V(?:CW|SP)(?:0[1-9]|10)|T(?:CW|SP)(?:0[1-9]|[12][0-9]|30))$"
    },
    "domain": {
      "enum": [
        "constrained_writing",
        "study_planning"
      ]
    },
    "initial_request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reference_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "user_control": {
      "enum": [
        "continue",
        "execute_now"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "domain",
    "initial_request",
    "reference_date",
    "user_control"
  ],
  "additionalProperties": false
}
